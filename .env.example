# PostgreSQL Database Configuration
POSTGRES_DB=sourcify
POSTGRES_USER=sourcify
POSTGRES_PASSWORD=sourcify
POSTGRES_PORT=5432

# Service Ports
SERVER_PORT=5555
FOURBYTE_PORT=4444

# Node Environment
NODE_ENV=development

# API Keys for RPC providers (optional but recommended)
# Without these, some chains may not be accessible
# Get free keys from:
# - Alchemy: https://www.alchemy.com/
# - Infura: https://www.infura.io/
ALCHEMY_API_KEY=placeholder
INFURA_API_KEY=placeholder
DRPC_API_KEY=placeholder
ZIRCUIT_API_KEY=placeholder
CF_ACCESS_CLIENT_ID=placeholder
CF_ACCESS_CLIENT_SECRET=placeholder

# Monitor Logging
NODE_LOG_LEVEL=info

# Parquet Sync Configuration
MANIFEST_URL=https://export.sourcify.dev/manifest.json
SYNC_MODE=incremental
SYNC_SCHEDULE=0 2 * * *
SYNC_BATCH_SIZE=10000
CLEANUP_AFTER_IMPORT=true  # Delete parquet files after successful import to save disk space
SYNC_MANAGE_INDEXES=false