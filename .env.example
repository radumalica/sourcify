# PostgreSQL Database Configuration
POSTGRES_DB=sourcify
POSTGRES_USER=sourcify
POSTGRES_PASSWORD=sourcify
POSTGRES_PORT=5432

# Service Ports
SERVER_PORT=5555
FOURBYTE_PORT=4444

# Node Environment
NODE_ENV=development

# Monitor Service API Keys
# Required for chain monitoring functionality
ALCHEMY_API_KEY=
INFURA_API_KEY=
DRPC_API_KEY=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Monitor Logging
NODE_LOG_LEVEL=info

# Parquet Sync Configuration
MANIFEST_URL=https://export.sourcify.dev/manifest.json
SYNC_MODE=incremental
SYNC_SCHEDULE=0 2 * * *
SYNC_BATCH_SIZE=10000
CLEANUP_AFTER_IMPORT=true  # Delete parquet files after successful import to save disk space
